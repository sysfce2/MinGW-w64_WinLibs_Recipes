export NAME="troffcvt"
export STATUS=
export URL=http://www.snake.net/software/troffcvt/
export BASENAME=troffcvt
export DESCRIPTION="troffcvt is a translator that turns troff input into a form that can be more easily processed. The troffcvt distribution comes with postprocessors that turn troffcvt into various destination formats such as HTML (Hypertext Markup Language), RTF (Rich Text Format) or plain text."
export CATEGORY=fileformat
export TYPE=application
export VERSION=1.04
export VERSIONDATE=20220601
wl-showstatus --package-version
export DEPENDENCIES=
export OPTIONALDEPENDENCIES=
export BUILDDEPENDENCIES=msub
export OPTIONALBUILDDEPENDENCIES=
export LICENSEFILE=
export LICENSETYPE=
#export DOWNLOADURL="http://www.snake.net/software/troffcvt/"
export DOWNLOADURL="https://mirror.mirohost.net/debian/pool/main/t/troffcvt/"
export INSTALLPREFIX=`pwd`/inst_$BASENAME-$VERSION
#export DOWNLOADSOURCEURL=http://www.snake.net/software/troffcvt/$BASENAME-$VERSION.tar.gz
export DOWNLOADSOURCEURL=https://mirror.mirohost.net/debian/pool/main/t/troffcvt/troffcvt_$VERSION.orig.tar.gz
wl-showstatus download
wl-download -v -d $TARBALLDIR/$BASENAME $DOWNLOADSOURCEURL
wl-wait4deps
wl-showstatus extract
#tar xz --force-local -f $TARBALLDIR/$BASENAME/$BASENAME-$VERSION.tar.gz
tar xz --force-local -f $TARBALLDIR/$BASENAME/troffcvt_$VERSION.orig.tar.gz
tar x --force-local -f troffcvt-$VERSION.orig/tarballs/troffcvt-$VERSION.tar -Ctroffcvt-$VERSION.orig
#cd $BASENAME-$VERSION
cd troffcvt-$VERSION.orig/$BASENAME-$VERSION
sed -i.bak -e "s? /usr/\(local/\)*include/[^ ]*??g" */Makefile
wl-showstatus build &&
 make -j1 TMPDIR=$TEMP CC="${CC:-gcc}" CCOPTIONS="-std=c11" &&
 #make CC="${CC:-gcc}" &&
    echo OK
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd .. && wl-showstatus cleanup && rm -rf $BASENAME-$VERSION
# wl-makepackage -c -d && wl-install -d $BASENAME-$VERSION && cd ../.. && wl-showstatus cleanup && rm -rf troffcvt-$VERSION.orig



